
    // --- MÉTODOS DE DESENHO REALISTA ---

    drawLionHead(ctx, size) {
        // Juba
        ctx.fillStyle = '#8B4513'; // Marrom sela
        ctx.beginPath();
        ctx.arc(0, 0, size * 1.4, 0, Math.PI * 2);
        ctx.fill();

        // Rosto
        ctx.fillStyle = '#DAA520'; // Dourado
        ctx.beginPath();
        ctx.arc(0, 0, size, 0, Math.PI * 2);
        ctx.fill();

        // Orelhas
        ctx.beginPath();
        ctx.arc(size * 0.8, -size * 0.5, size * 0.3, 0, Math.PI * 2);
        ctx.arc(size * 0.8, size * 0.5, size * 0.3, 0, Math.PI * 2);
        ctx.fill();

        // Focinho
        ctx.fillStyle = '#000000';
        ctx.beginPath();
        ctx.moveTo(size * 0.8, -size * 0.2);
        ctx.lineTo(size * 1.1, 0);
        ctx.lineTo(size * 0.8, size * 0.2);
        ctx.fill();

        // Olhos
        this.drawAngryFace(ctx, size, '#ffff00');
    }

    drawCowHead(ctx, size) {
        // Orelhas
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.ellipse(size * 0.5, -size * 0.8, size * 0.3, size * 0.6, -Math.PI/4, 0, Math.PI * 2);
        ctx.ellipse(size * 0.5, size * 0.8, size * 0.3, size * 0.6, Math.PI/4, 0, Math.PI * 2);
        ctx.fill();

        // Chifres
        ctx.fillStyle = '#e0e0e0';
        ctx.beginPath();
        ctx.moveTo(size * 0.2, -size * 0.5);
        ctx.lineTo(size * 0.8, -size * 1.0);
        ctx.lineTo(size * 0.6, -size * 0.3);
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(size * 0.2, size * 0.5);
        ctx.lineTo(size * 0.8, size * 1.0);
        ctx.lineTo(size * 0.6, size * 0.3);
        ctx.fill();

        // Rosto Base
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(0, 0, size, 0, Math.PI * 2);
        ctx.fill();

        // Manchas
        ctx.fillStyle = '#000000';
        ctx.beginPath();
        ctx.arc(size * 0.2, size * 0.5, size * 0.2, 0, Math.PI * 2);
        ctx.fill();

        // Focinho Rosa
        ctx.fillStyle = '#ffb6c1';
        ctx.beginPath();
        ctx.ellipse(size * 0.7, 0, size * 0.3, size * 0.4, 0, 0, Math.PI * 2);
        ctx.fill();

        // Narinas
        ctx.fillStyle = '#000000';
        ctx.beginPath();
        ctx.arc(size * 0.8, -size * 0.15, size * 0.05, 0, Math.PI * 2);
        ctx.arc(size * 0.8, size * 0.15, size * 0.05, 0, Math.PI * 2);
        ctx.fill();

        // Olhos
        this.drawStandardFace(ctx, size, '#000000');
    }

    drawRabbitHead(ctx, size) {
        // Orelhas Longas
        ctx.fillStyle = '#f5f5f5';
        ctx.beginPath();
        ctx.ellipse(0, -size * 1.2, size * 0.3, size * 0.8, -Math.PI/6, 0, Math.PI * 2);
        ctx.ellipse(0, size * 1.2, size * 0.3, size * 0.8, Math.PI/6, 0, Math.PI * 2);
        ctx.fill();

        // Interior Rosa das Orelhas
        ctx.fillStyle = '#ffb6c1';
        ctx.beginPath();
        ctx.ellipse(0, -size * 1.2, size * 0.15, size * 0.6, -Math.PI/6, 0, Math.PI * 2);
        ctx.ellipse(0, size * 1.2, size * 0.15, size * 0.6, Math.PI/6, 0, Math.PI * 2);
        ctx.fill();

        // Rosto
        ctx.fillStyle = '#f5f5f5';
        ctx.beginPath();
        ctx.arc(0, 0, size, 0, Math.PI * 2);
        ctx.fill();

        // Nariz
        ctx.fillStyle = '#ff69b4';
        ctx.beginPath();
        ctx.arc(size * 0.9, 0, size * 0.15, 0, Math.PI * 2);
        ctx.fill();

        // Bigodes
        ctx.strokeStyle = '#000000';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(size * 0.8, -size * 0.1); ctx.lineTo(size * 1.5, -size * 0.5);
        ctx.moveTo(size * 0.8, size * 0.1); ctx.lineTo(size * 1.5, size * 0.5);
        ctx.stroke();

        // Olhos
        this.drawCuteFace(ctx, size, '#000000');
    }

     drawFoxHead(ctx, size) {
        // Orelhas Pontudas
        ctx.fillStyle = '#ff6347';
        ctx.beginPath();
        ctx.moveTo(0, -size * 0.5); ctx.lineTo(size * 0.5, -size * 1.5); ctx.lineTo(size * 0.8, -size * 0.5);
        ctx.moveTo(0, size * 0.5); ctx.lineTo(size * 0.5, size * 1.5); ctx.lineTo(size * 0.8, size * 0.5);
        ctx.fill();

        // Rosto Laranja
        ctx.fillStyle = '#ff6347';
        ctx.beginPath();
        ctx.arc(0, 0, size, 0, Math.PI * 2);
        ctx.fill();

        // Bochechas Brancas (Focinho)
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(size * 0.5, 0, size * 0.7, 0, Math.PI * 2);
        ctx.fill();

        // Nariz Preto
        ctx.fillStyle = '#000000';
        ctx.beginPath();
        ctx.arc(size * 1.0, 0, size * 0.15, 0, Math.PI * 2);
        ctx.fill();

        // Olhos
        this.drawCuteFace(ctx, size, '#000000');
    }
