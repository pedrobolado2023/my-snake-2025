{
    "appId": "com.mysnake.game2025",
    "appName": "My Snake 2025",
    "webDir": "www",
    "bundledWebRuntime": false,
    "server": {
        "androidScheme": "https",
        "cleartext": true,
        "allowNavigation": [
            "*.firebaseapp.com",
            "*.googleapis.com",
            "*.gstatic.com"
        ]
    },
    "plugins": {
        "SplashScreen": {
            "launchShowDuration": 2000,
            "backgroundColor": "#0a0e27",
            "showSpinner": false,
            "androidSpinnerStyle": "small",
            "spinnerColor": "#00ffcc"
        },
        "StatusBar": {
            "style": "dark",
            "backgroundColor": "#0a0e27"
        }
    },
    "android": {
        "buildOptions": {
            "keystorePath": "",
            "keystorePassword": "",
            "keystoreAlias": "",
            "keystoreAliasPassword": "",
            "releaseType": "APK"
        }
    }
}